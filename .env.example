# Canonical public site URL used for metadata, canonicals, sitemap and JSON-LD.
# Required in Vercel production. Update this when a custom domain replaces Vercel.
NEXT_PUBLIC_SITE_URL=https://premium-portfolio-phi.vercel.app

# Vercel supplies VERCEL_ENV, VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL.
# Do not configure those manually in the Vercel dashboard.
